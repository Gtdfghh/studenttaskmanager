<ContentView
    x:Class="StudentTaskManager.AddCoursePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#F4F6FA">

    <ScrollView>
        <VerticalStackLayout Padding="40,30"
                             Spacing="12">

            <Label Text="Add Course"
                   FontSize="40"
                   TextColor="#1E2B3F"/>

            <Label Text="Add a new course to the system."
                   FontSize="16"
                   TextColor="#64748B"/>

            <Border BackgroundColor="White"
                    Stroke="#E0E4EA"
                    StrokeThickness="1"
                    Padding="30"
                    Margin="0,18,0,0"
                    HorizontalOptions="Start"
                    WidthRequest="700">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="10">

                    <Label Text="Course Name"
                           TextColor="#526078"
                           FontSize="14"/>

                    <Border BackgroundColor="White"
                            Stroke="#CCCCCC"
                            StrokeThickness="1"
                            HeightRequest="48"
                            Padding="10,0">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="6"/>
                        </Border.StrokeShape>

                        <Entry x:Name="courseNameEntry"
                               Placeholder="Enter course name"
                               BackgroundColor="Transparent"
                               TextColor="#212529"
                               PlaceholderColor="#777777"
                               FontSize="15"
                               HeightRequest="46"
                               VerticalOptions="Center"/>
                    </Border>

                    <Label Text="Description"
                           TextColor="#526078"
                           FontSize="14"
                           Margin="0,8,0,0"/>

                    <Border BackgroundColor="White"
                            Stroke="#CCCCCC"
                            StrokeThickness="1"
                            HeightRequest="100"
                            Padding="10,5">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="6"/>
                        </Border.StrokeShape>

                        <Editor x:Name="descriptionEditor"
                                Placeholder="Enter course description"
                                BackgroundColor="Transparent"
                                TextColor="#212529"
                                FontSize="15"
                                HeightRequest="90"
                                AutoSize="Disabled"/>
                    </Border>

                    <Label Text="Duration"
                           TextColor="#526078"
                           FontSize="14"
                           Margin="0,8,0,0"/>

                    <Border BackgroundColor="White"
                            Stroke="#CCCCCC"
                            StrokeThickness="1"
                            HeightRequest="48"
                            Padding="10,0">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="6"/>
                        </Border.StrokeShape>

                        <Entry x:Name="durationEntry"
                               Placeholder="Enter course duration"
                               BackgroundColor="Transparent"
                               TextColor="#212529"
                               FontSize="15"
                               HeightRequest="46"
                               VerticalOptions="Center"/>
                    </Border>

                    <HorizontalStackLayout Spacing="12"
                                           Margin="0,15,0,0">

                        <Button Text="Add Course"
                                BackgroundColor="#198754"
                                TextColor="White"
                                Clicked="AddCourse_Clicked"/>

                        <Button Text="Cancel"
                                BackgroundColor="White"
                                TextColor="#212529"
                                BorderColor="#CCCCCC"
                                BorderWidth="1"
                                Clicked="Cancel_Clicked"/>
                    </HorizontalStackLayout>

                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentView>