<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    x:Class="StudentTaskManager.MyProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#F4F6FA">

    <!-- THIS AREA SWITCHES BETWEEN PROFILE AND EDIT FORM -->
    <ContentView x:Name="profileContentArea">

        <!-- ORIGINAL PROFILE VIEW -->
        <ScrollView>

            <VerticalStackLayout
                Padding="55,35"
                Spacing="12">

                <Label
                    Text="My Profile"
                    FontSize="40"
                    TextColor="#20344D"/>

                <Label
                    Text="View your personal and academic information."
                    FontSize="16"
                    TextColor="#555555"/>

                <!-- PROFILE CARD -->
                <Border
                    BackgroundColor="White"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    Padding="30"
                    Margin="0,18,0,20">

                    <VerticalStackLayout Spacing="25">

                        <!-- PROFILE HEADER -->
                        <HorizontalStackLayout
                            Spacing="20"
                            VerticalOptions="Center">

                            <Border
                                BackgroundColor="#347FF0"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 50"
                                WidthRequest="70"
                                HeightRequest="70">

                                <Label
                                    Text="👤"
                                    FontSize="34"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"/>

                            </Border>

                            <VerticalStackLayout
                                VerticalOptions="Center"
                                Spacing="5">

                                <Label
                                    x:Name="profileNameLabel"
                                    Text="Student Name"
                                    FontSize="28"
                                    TextColor="#172B45"/>

                                <Label
                                    x:Name="headerStudentIdLabel"
                                    Text="Student ID: -"
                                    FontSize="15"
                                    TextColor="#777777"/>

                            </VerticalStackLayout>

                        </HorizontalStackLayout>

                        <!-- PROFILE DETAILS -->
                        <Grid
                            ColumnDefinitions="*,*"
                            RowDefinitions="Auto,Auto,Auto"
                            ColumnSpacing="20"
                            RowSpacing="20">

                            <!-- STUDENT ID -->
                            <Border
                                Grid.Row="0"
                                Grid.Column="0"
                                BackgroundColor="#F6F7F9"
                                StrokeThickness="0"
                                Padding="18">

                                <VerticalStackLayout Spacing="7">

                                    <Label
                                        Text="Student ID"
                                        TextColor="#777777"
                                        FontSize="14"/>

                                    <Label
                                        x:Name="studentIdLabel"
                                        Text="-"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        TextColor="#172B45"/>

                                </VerticalStackLayout>
                            </Border>

                            <!-- FULL NAME -->
                            <Border
                                Grid.Row="0"
                                Grid.Column="1"
                                BackgroundColor="#F6F7F9"
                                StrokeThickness="0"
                                Padding="18">

                                <VerticalStackLayout Spacing="7">

                                    <Label
                                        Text="Full Name"
                                        TextColor="#777777"
                                        FontSize="14"/>

                                    <Label
                                        x:Name="fullNameLabel"
                                        Text="-"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        TextColor="#172B45"/>

                                </VerticalStackLayout>
                            </Border>

                            <!-- DATE OF BIRTH -->
                            <Border
                                Grid.Row="1"
                                Grid.Column="0"
                                BackgroundColor="#F6F7F9"
                                StrokeThickness="0"
                                Padding="18">

                                <VerticalStackLayout Spacing="7">

                                    <Label
                                        Text="Date of Birth"
                                        TextColor="#777777"
                                        FontSize="14"/>

                                    <Label
                                        x:Name="dateOfBirthLabel"
                                        Text="-"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        TextColor="#172B45"/>

                                </VerticalStackLayout>
                            </Border>

                            <!-- PHONE -->
                            <Border
                                Grid.Row="1"
                                Grid.Column="1"
                                BackgroundColor="#F6F7F9"
                                StrokeThickness="0"
                                Padding="18">

                                <VerticalStackLayout Spacing="7">

                                    <Label
                                        Text="Phone"
                                        TextColor="#777777"
                                        FontSize="14"/>

                                    <Label
                                        x:Name="phoneLabel"
                                        Text="-"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        TextColor="#172B45"/>

                                </VerticalStackLayout>
                            </Border>

                            <!-- DEPARTMENT -->
                            <Border
                                Grid.Row="2"
                                Grid.Column="0"
                                BackgroundColor="#F6F7F9"
                                StrokeThickness="0"
                                Padding="18">

                                <VerticalStackLayout Spacing="7">

                                    <Label
                                        Text="Department"
                                        TextColor="#777777"
                                        FontSize="14"/>

                                    <Label
                                        x:Name="departmentLabel"
                                        Text="-"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        TextColor="#172B45"/>

                                </VerticalStackLayout>
                            </Border>

                            <!-- YEAR -->
                            <Border
                                Grid.Row="2"
                                Grid.Column="1"
                                BackgroundColor="#F6F7F9"
                                StrokeThickness="0"
                                Padding="18">

                                <VerticalStackLayout Spacing="7">

                                    <Label
                                        Text="Year"
                                        TextColor="#777777"
                                        FontSize="14"/>

                                    <Label
                                        x:Name="yearLabel"
                                        Text="-"
                                        FontSize="16"
                                        FontAttributes="Bold"
                                        TextColor="#172B45"/>

                                </VerticalStackLayout>
                            </Border>

                        </Grid>

                        <!-- EDIT PROFILE BUTTON -->
                        <Button
                            Text="✏️ Edit Profile"
                            BackgroundColor="#347FF0"
                            TextColor="White"
                            FontAttributes="Bold"
                            FontSize="15"
                            CornerRadius="6"
                            WidthRequest="150"
                            HeightRequest="48"
                            HorizontalOptions="Center"
                            Clicked="EditProfile_Clicked"/>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>

        </ScrollView>

    </ContentView>

</ContentView>