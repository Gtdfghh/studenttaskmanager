<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="StudentTaskManager.ResetPasswordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:StudentTaskManager"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F5F7FA">

    <Grid RowDefinitions="65,*,Auto">

        <views:AppHeader Grid.Row="0"/>

        <ScrollView Grid.Row="1">
            <Grid Padding="20"
                  VerticalOptions="Center">

                <Border
                    BackgroundColor="White"
                    StrokeThickness="0"
                    Padding="35"
                    MaximumWidthRequest="520"
                    HorizontalOptions="Center">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20"/>
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow Brush="#000000"
                                Opacity="0.10"
                                Radius="20"
                                Offset="0,8"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="18">

                        <Border BackgroundColor="#E8F0FF"
                                WidthRequest="65"
                                HeightRequest="65"
                                StrokeThickness="0"
                                HorizontalOptions="Center">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="40"/>
                            </Border.StrokeShape>

                            <Label Text="🔐"
                                   FontSize="30"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"/>
                        </Border>

                        <Label Text="Reset Password"
                               FontSize="28"
                               FontAttributes="Bold"
                               TextColor="#172B4D"
                               HorizontalTextAlignment="Center"/>

                        <Label
                            Text="Create a new password for your account. Make sure it is strong and secure."
                            FontSize="15"
                            TextColor="#64748B"
                            HorizontalTextAlignment="Center"/>

                        <!-- NEW PASSWORD -->
                        <Label Text="New Password"
                               TextColor="#475569"
                               FontSize="14"
                               Margin="0,15,0,0"/>

                        <Border x:Name="newPasswordBorder"
                                Stroke="#D5D5D5"
                                StrokeThickness="1"
                                Padding="12,2">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="7"/>
                            </Border.StrokeShape>

                            <Entry x:Name="newPasswordEntry"
                                   Placeholder="Enter new password"
                                   IsPassword="True"
                                   FontSize="15"
                                   TextColor="#333333"/>
                        </Border>

                        <Label x:Name="newPasswordErrorLabel"
                               IsVisible="False"
                               TextColor="#DC3545"
                               FontSize="12"/>

                        <!-- CONFIRM PASSWORD -->
                        <Label Text="Confirm Password"
                               TextColor="#475569"
                               FontSize="14"/>

                        <Border x:Name="confirmPasswordBorder"
                                Stroke="#D5D5D5"
                                StrokeThickness="1"
                                Padding="12,2">

                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="7"/>
                            </Border.StrokeShape>

                            <Entry x:Name="confirmPasswordEntry"
                                   Placeholder="Confirm your new password"
                                   IsPassword="True"
                                   FontSize="15"
                                   TextColor="#333333"/>
                        </Border>

                        <Label x:Name="confirmPasswordErrorLabel"
                               IsVisible="False"
                               TextColor="#DC3545"
                               FontSize="12"/>

                        <Label x:Name="generalErrorLabel"
                               IsVisible="False"
                               TextColor="#DC3545"
                               FontSize="13"/>

                        <!-- RESET BUTTON -->
                        <Button x:Name="resetButton"
                                Text="Reset Password"
                                BackgroundColor="#0D6EFD"
                                TextColor="White"
                                FontAttributes="Bold"
                                FontSize="15"
                                HeightRequest="52"
                                CornerRadius="9"
                                Clicked="ResetPassword_Clicked"/>

                        <!-- BACK TO LOGIN -->
                        <HorizontalStackLayout
                            HorizontalOptions="Center"
                            Spacing="4"
                            Margin="0,5,0,0">

                            <Label Text="Remember your password?"
                                   TextColor="#64748B"
                                   FontSize="14"/>

                            <Label Text="Back to Login"
                                   TextColor="#0D6EFD"
                                   FontAttributes="Bold"
                                   FontSize="14">

                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Tapped="BackToLogin_Clicked"/>
                                </Label.GestureRecognizers>
                            </Label>

                        </HorizontalStackLayout>

                    </VerticalStackLayout>
                </Border>
            </Grid>
        </ScrollView>

        <Grid Grid.Row="2" Padding="10">
            <Label Text="© 2026 Student Course Management System"
                   TextColor="#64748B"
                   HorizontalTextAlignment="Center"
                   FontSize="14"/>
        </Grid>

        <!-- SUCCESS TOAST -->
        <Border x:Name="successToast"
                Grid.Row="1"
                IsVisible="False"
                Opacity="0"
                BackgroundColor="#198754"
                Padding="18,12"
                HorizontalOptions="Center"
                VerticalOptions="Start"
                Margin="15,15,15,0"
                ZIndex="10">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="10"/>
            </Border.StrokeShape>

            <HorizontalStackLayout Spacing="10">
                <Label Text="✓"
                       TextColor="White"
                       FontSize="20"
                       FontAttributes="Bold"/>

                <Label Text="Password reset successfully!"
                       TextColor="White"
                       FontSize="14"
                       FontAttributes="Bold"
                       VerticalOptions="Center"/>
            </HorizontalStackLayout>
        </Border>

    </Grid>
</ContentPage>
