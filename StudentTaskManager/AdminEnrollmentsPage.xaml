<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="StudentTaskManager.AdminEnrollmentsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    BackgroundColor="#F4F6FA">

    <ScrollView>
        <VerticalStackLayout Padding="35,38" Spacing="12">

            <Label Text="Enrollments"
                   FontSize="40"
                   TextColor="#1E2B3F"/>

            <Label Text="View students enrolled in each course."
                   FontSize="16"
                   TextColor="#64748B"/>

            <!-- CENTERED SEARCH -->
            <Grid Margin="0,15,0,15"
                  ColumnDefinitions="*,Auto,10,Auto,*">

                <Border Grid.Column="1"
                        WidthRequest="340"
                        HeightRequest="50"
                        Stroke="#CCCCCC"
                        StrokeThickness="1"
                        BackgroundColor="White"
                        Padding="10,0">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="6"/>
                    </Border.StrokeShape>

                    <Entry x:Name="searchEntry"
                           Placeholder="Search students or courses..."
                           BackgroundColor="Transparent"
                           TextColor="#212529"
                           PlaceholderColor="#777777"
                           VerticalOptions="Center"/>
                </Border>

                <Button Grid.Column="3"
                        Text="🔍 Search"
                        WidthRequest="130"
                        HeightRequest="50"
                        BackgroundColor="#0D6EFD"
                        TextColor="White"
                        Clicked="Search_Clicked"/>
            </Grid>

            <!-- ENROLLMENT TABLE -->
            <Border BackgroundColor="White"
                    StrokeThickness="0"
                    Padding="25">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>

                <VerticalStackLayout Spacing="0">

                    <Grid BackgroundColor="#F0F2F4"
                          Padding="15"
                          ColumnDefinitions="1.2*,1.2*,1.5*,1.5*,1.2*">

                        <Label Text="Enrollment ID"
                               FontAttributes="Bold"
                               TextColor="#212529"/>

                        <Label Grid.Column="1"
                               Text="Student ID"
                               FontAttributes="Bold"
                               TextColor="#212529"/>

                        <Label Grid.Column="2"
                               Text="Student Name"
                               FontAttributes="Bold"
                               TextColor="#212529"/>

                        <Label Grid.Column="3"
                               Text="Course Name"
                               FontAttributes="Bold"
                               TextColor="#212529"/>

                        <Label Grid.Column="4"
                               Text="Duration"
                               FontAttributes="Bold"
                               TextColor="#212529"/>
                    </Grid>

                    <VerticalStackLayout x:Name="enrollmentsContainer"
                                         Spacing="0"/>

                    <Label x:Name="noEnrollmentsLabel"
                           Text="No enrollments found."
                           TextColor="#64748B"
                           FontSize="15"
                           HorizontalTextAlignment="Center"
                           Padding="20"
                           IsVisible="True"/>

                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentView>
