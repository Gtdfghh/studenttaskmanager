<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:StudentTaskManager"
    x:Class="StudentTaskManager.MainPage"
    Title="Home"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F4F6FA">

    <ScrollView x:Name="homeScrollView">

        <VerticalStackLayout Spacing="0">

            <!-- 1. REUSABLE NAVIGATION BAR -->

            <views:AppHeader />

            <!-- 2. HERO SECTION -->

            <Grid
                Padding="45,55"
                ColumnDefinitions="1.3*,1*"
                ColumnSpacing="35">

                <!-- LEFT SIDE -->

                <VerticalStackLayout
                    Spacing="18"
                    VerticalOptions="Center">

                    <Border
                        BackgroundColor="#D9E8FF"
                        StrokeThickness="0"
                        Padding="14,7"
                        HorizontalOptions="Start"
                        StrokeShape="RoundRectangle 20">

                        <Label
                            Text="STUDENT COURSE MANAGEMENT SYSTEM"
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="#0D6EFD"/>

                    </Border>

                    <Label
                        Text="Everything you need to"
                        FontSize="38"
                        FontAttributes="Bold"
                        TextColor="#212529"/>

                    <Label
                        Text="manage academics."
                        FontSize="38"
                        FontAttributes="Bold"
                        TextColor="#0D6EFD"/>

                    <Label
                        Text="Manage students, courses and enrollments through one simple and organized platform."
                        FontSize="18"
                        TextColor="#667085"
                        LineBreakMode="WordWrap"/>

                    <Button
                        Text="Learn More"
                        BackgroundColor="Transparent"
                        TextColor="#667085"
                        BorderColor="#667085"
                        BorderWidth="1"
                        CornerRadius="8"
                        HorizontalOptions="Start"
                        Padding="20,10"
                        Clicked="OnLearnMoreClicked"/>

                </VerticalStackLayout>

                <!-- RIGHT SIDE: DASHBOARD -->

                <Border
                    Grid.Column="1"
                    BackgroundColor="White"
                    StrokeThickness="0"
                    Padding="25"
                    StrokeShape="RoundRectangle 18"
                    VerticalOptions="Center">

                    <VerticalStackLayout Spacing="18">

                        <!-- DASHBOARD HEADING -->

                        <HorizontalStackLayout
                            Spacing="15"
                            VerticalOptions="Center">

                            <Border
                                BackgroundColor="#0D6EFD"
                                Padding="12"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 10">

                                <Label
                                    Text="🎓"
                                    FontSize="25"/>

                            </Border>

                            <VerticalStackLayout Spacing="3">

                                <Label
                                    Text="Academic Dashboard"
                                    FontSize="19"
                                    FontAttributes="Bold"
                                    TextColor="#212529"/>

                                <Label
                                    Text="Overview"
                                    FontSize="13"
                                    TextColor="#667085"/>

                            </VerticalStackLayout>

                        </HorizontalStackLayout>

                        <!-- STUDENTS -->

                        <Grid
                            ColumnDefinitions="*,Auto"
                            Padding="0,12">

                            <VerticalStackLayout Spacing="3">

                                <Label
                                    Text="Students"
                                    FontSize="14"
                                    TextColor="#667085"/>

                                <Label
                                    Text="2"
                                    FontSize="22"
                                    FontAttributes="Bold"
                                    TextColor="#212529"/>

                            </VerticalStackLayout>

                            <Border
                                Grid.Column="1"
                                BackgroundColor="#D9E8FF"
                                Padding="13"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 30">

                                <Label
                                    Text="👨‍🎓"
                                    FontSize="20"/>

                            </Border>

                        </Grid>

                        <BoxView
                            HeightRequest="1"
                            Color="#DDE2E8"/>

                        <!-- COURSES -->

                        <Grid
                            ColumnDefinitions="*,Auto"
                            Padding="0,12">

                            <VerticalStackLayout Spacing="3">

                                <Label
                                    Text="Courses"
                                    FontSize="14"
                                    TextColor="#667085"/>

                                <Label
                                    Text="2"
                                    FontSize="22"
                                    FontAttributes="Bold"
                                    TextColor="#212529"/>

                            </VerticalStackLayout>

                            <Border
                                Grid.Column="1"
                                BackgroundColor="#D6F0E6"
                                Padding="13"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 30">

                                <Label
                                    Text="📚"
                                    FontSize="20"/>

                            </Border>

                        </Grid>

                        <BoxView
                            HeightRequest="1"
                            Color="#DDE2E8"/>

                        <!-- ENROLLMENTS -->

                        <Grid
                            ColumnDefinitions="*,Auto"
                            Padding="0,12">

                            <VerticalStackLayout Spacing="3">

                                <Label
                                    Text="Enrollments"
                                    FontSize="14"
                                    TextColor="#667085"/>

                                <Label
                                    Text="4"
                                    FontSize="22"
                                    FontAttributes="Bold"
                                    TextColor="#212529"/>

                            </VerticalStackLayout>

                            <Border
                                Grid.Column="1"
                                BackgroundColor="#FFF0C7"
                                Padding="13"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 30">

                                <Label
                                    Text="📝"
                                    FontSize="20"/>

                            </Border>

                        </Grid>

                    </VerticalStackLayout>

                </Border>

            </Grid>

            <!-- 3. FEATURES SECTION -->

            <VerticalStackLayout
                x:Name="featuresSection"
                BackgroundColor="White"
                Padding="30,55"
                Spacing="15">

                <Label
                    Text="FEATURES"
                    FontSize="15"
                    FontAttributes="Bold"
                    TextColor="#0D6EFD"
                    HorizontalOptions="Center"/>

                <Label
                    Text="Everything in one place"
                    FontSize="28"
                    FontAttributes="Bold"
                    TextColor="#212529"
                    HorizontalOptions="Center"/>

                <Label
                    Text="A centralized system for managing academic information."
                    FontSize="15"
                    TextColor="#667085"
                    HorizontalTextAlignment="Center"/>

                <!-- FEATURE CARDS -->

                <Grid
                    ColumnDefinitions="*,*,*"
                    ColumnSpacing="20"
                    Margin="0,25,0,0">

                    <!-- STUDENT MANAGEMENT -->

                    <Border
                        BackgroundColor="#F4F7FC"
                        StrokeThickness="0"
                        Padding="20"
                        StrokeShape="RoundRectangle 15">

                        <VerticalStackLayout Spacing="12">

                            <Border
                                BackgroundColor="#D9E8FF"
                                StrokeThickness="0"
                                Padding="12"
                                HorizontalOptions="Start"
                                StrokeShape="RoundRectangle 10">

                                <Label
                                    Text="👨‍🎓"
                                    FontSize="28"/>

                            </Border>

                            <Label
                                Text="Student Management"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="#212529"/>

                            <Label
                                Text="Maintain student information including personal details, department and academic year."
                                FontSize="14"
                                TextColor="#667085"
                                LineBreakMode="WordWrap"/>

                        </VerticalStackLayout>

                    </Border>

                    <!-- COURSE MANAGEMENT -->

                    <Border
                        Grid.Column="1"
                        BackgroundColor="#F4F7FC"
                        StrokeThickness="0"
                        Padding="20"
                        StrokeShape="RoundRectangle 15">

                        <VerticalStackLayout Spacing="12">

                            <Border
                                BackgroundColor="#D6F0E6"
                                StrokeThickness="0"
                                Padding="12"
                                HorizontalOptions="Start"
                                StrokeShape="RoundRectangle 10">

                                <Label
                                    Text="📚"
                                    FontSize="28"/>

                            </Border>

                            <Label
                                Text="Course Management"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="#212529"/>

                            <Label
                                Text="Create and organize courses with relevant course information and details."
                                FontSize="14"
                                TextColor="#667085"
                                LineBreakMode="WordWrap"/>

                        </VerticalStackLayout>

                    </Border>

                    <!-- ENROLLMENT MANAGEMENT -->

                    <Border
                        Grid.Column="2"
                        BackgroundColor="#F4F7FC"
                        StrokeThickness="0"
                        Padding="20"
                        StrokeShape="RoundRectangle 15">

                        <VerticalStackLayout Spacing="12">

                            <Border
                                BackgroundColor="#FFF0C7"
                                StrokeThickness="0"
                                Padding="12"
                                HorizontalOptions="Start"
                                StrokeShape="RoundRectangle 10">

                                <Label
                                    Text="📝"
                                    FontSize="28"/>

                            </Border>

                            <Label
                                Text="Enrollment Management"
                                FontSize="18"
                                FontAttributes="Bold"
                                TextColor="#212529"/>

                            <Label
                                Text="Manage student course enrollments and keep track of academic participation."
                                FontSize="14"
                                TextColor="#667085"
                                LineBreakMode="WordWrap"/>

                        </VerticalStackLayout>

                    </Border>

                </Grid>

            </VerticalStackLayout>

            <!-- 4. SIMPLE WORKFLOW SECTION -->

            <Grid
                BackgroundColor="#F4F6FA"
                Padding="45,55"
                ColumnDefinitions="*,*"
                ColumnSpacing="40">

                <!-- LEFT SIDE -->

                <VerticalStackLayout
                    Spacing="15"
                    VerticalOptions="Center">

                    <Label
                        Text="SIMPLE WORKFLOW"
                        FontSize="15"
                        FontAttributes="Bold"
                        TextColor="#0D6EFD"/>

                    <Label
                        Text="Manage your academic data with ease."
                        FontSize="28"
                        FontAttributes="Bold"
                        TextColor="#212529"/>

                    <Label
                        Text="The system provides a structured workflow for managing students, courses and enrollments."
                        FontSize="16"
                        TextColor="#667085"
                        LineBreakMode="WordWrap"/>

                </VerticalStackLayout>

                <!-- RIGHT SIDE: STEPS -->

                <VerticalStackLayout
                    Grid.Column="1"
                    Spacing="25">

                    <!-- STEP 1 -->

                    <HorizontalStackLayout Spacing="15">

                        <Border
                            BackgroundColor="#0D6EFD"
                            WidthRequest="45"
                            HeightRequest="45"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 30">

                            <Label
                                Text="1"
                                TextColor="White"
                                FontSize="20"
                                FontAttributes="Bold"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"/>

                        </Border>

                        <VerticalStackLayout Spacing="5">

                            <Label
                                Text="Register"
                                FontSize="19"
                                FontAttributes="Bold"
                                TextColor="#212529"/>

                            <Label
                                Text="Create an account to access the system."
                                FontSize="14"
                                TextColor="#667085"/>

                        </VerticalStackLayout>

                    </HorizontalStackLayout>

                    <!-- STEP 2 -->

                    <HorizontalStackLayout Spacing="15">

                        <Border
                            BackgroundColor="#0D6EFD"
                            WidthRequest="45"
                            HeightRequest="45"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 30">

                            <Label
                                Text="2"
                                TextColor="White"
                                FontSize="20"
                                FontAttributes="Bold"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"/>

                        </Border>

                        <VerticalStackLayout Spacing="5">

                            <Label
                                Text="Manage Students"
                                FontSize="19"
                                FontAttributes="Bold"
                                TextColor="#212529"/>

                            <Label
                                Text="Add and maintain student records."
                                FontSize="14"
                                TextColor="#667085"/>

                        </VerticalStackLayout>

                    </HorizontalStackLayout>

                    <!-- STEP 3 -->

                    <HorizontalStackLayout Spacing="15">

                        <Border
                            BackgroundColor="#0D6EFD"
                            WidthRequest="45"
                            HeightRequest="45"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 30">

                            <Label
                                Text="3"
                                TextColor="White"
                                FontSize="20"
                                FontAttributes="Bold"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"/>

                        </Border>

                        <VerticalStackLayout Spacing="5">

                            <Label
                                Text="Manage Courses"
                                FontSize="19"
                                FontAttributes="Bold"
                                TextColor="#212529"/>

                            <Label
                                Text="Organize courses and student enrollments."
                                FontSize="14"
                                TextColor="#667085"/>

                        </VerticalStackLayout>

                    </HorizontalStackLayout>

                </VerticalStackLayout>

            </Grid>

            <!-- 5. GET STARTED SECTION -->

            <VerticalStackLayout
                BackgroundColor="White"
                Padding="30,45">

                <Border
                    BackgroundColor="#0D6EFD"
                    StrokeThickness="0"
                    Padding="35"
                    StrokeShape="RoundRectangle 18">

                    <VerticalStackLayout
                        Spacing="18"
                        HorizontalOptions="Center">

                        <Label
                            Text="Ready to get started?"
                            FontSize="28"
                            FontAttributes="Bold"
                            TextColor="White"
                            HorizontalTextAlignment="Center"/>

                        <Label
                            Text="Start managing your student records today."
                            FontSize="17"
                            TextColor="White"
                            HorizontalTextAlignment="Center"/>

                        <Button
                            Text="Get Started"
                            BackgroundColor="White"
                            TextColor="#0D6EFD"
                            FontSize="16"
                            FontAttributes="Bold"
                            CornerRadius="8"
                            Padding="30,12"
                            HorizontalOptions="Center"
                            Clicked="OnGetStartedClicked"/>

                    </VerticalStackLayout>

                </Border>

            </VerticalStackLayout>

            <!-- 6. FOOTER SECTION -->

            <Grid
                BackgroundColor="White"
                Padding="15"
                ColumnDefinitions="*">

                <BoxView
                    HeightRequest="1"
                    Color="#DDE2E8"
                    VerticalOptions="Start"/>

                <Label
                    Text="© 2026 Student Course Management System"
                    FontSize="14"
                    TextColor="#667085"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Margin="0,8,0,0"/>

            </Grid>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
