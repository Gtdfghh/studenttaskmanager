<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:StudentTaskManager"
    x:Class="StudentTaskManager.LoginPage"
    Title="Login"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F4F6FA">

    <ScrollView>

        <VerticalStackLayout Spacing="0">

            <!-- REUSABLE NAVIGATION BAR -->
            <views:AppHeader />

            <!-- LOGIN SECTION -->
            <Grid
                Padding="25,45"
                MinimumHeightRequest="620">

                <Border
                    BackgroundColor="White"
                    Stroke="#FFFFFF"
                    StrokeThickness="0"
                    Padding="40"
                    StrokeShape="RoundRectangle 18"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    WidthRequest="525">

                    <Border.Shadow>
                        <Shadow
                            Brush="#000000"
                            Offset="0,10"
                            Radius="25"
                            Opacity="0.15"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="18">

                        <!-- HEADING -->
                        <Label
                            Text="Welcome Back"
                            FontSize="30"
                            FontAttributes="Bold"
                            TextColor="#212529"
                            HorizontalOptions="Center"/>

                        <Label
                            Text="Login to your Student Course Management account"
                            FontSize="15"
                            TextColor="#667085"
                            HorizontalTextAlignment="Center"/>

                        <!-- GENERAL LOGIN ERROR AT TOP -->
                        <Label
                            x:Name="loginErrorLabel"
                            Text=""
                            FontSize="13"
                            TextColor="#DC3545"
                            HorizontalOptions="Start"
                            HorizontalTextAlignment="Start"
                            IsVisible="False"/>

                        <!-- EMAIL -->
                        <VerticalStackLayout Spacing="5">

                            <Label
                                Text="Email"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="#212529"/>

                            <Border
                                x:Name="emailBorder"
                                Stroke="#D5D5D5"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 6"
                                Padding="10,0"
                                HeightRequest="49">

                                <Entry
                                    x:Name="emailEntry"
                                    Placeholder="Enter your email"
                                    PlaceholderColor="#667085"
                                    TextColor="#212529"
                                    BackgroundColor="Transparent"
                                    Keyboard="Email"
                                    VerticalOptions="Center"
                                    TextChanged="Email_TextChanged"
                                    Focused="Email_Focused"
                                    Unfocused="Email_Unfocused"/>

                            </Border>

                            <Label
                                x:Name="emailErrorLabel"
                                Text=""
                                FontSize="12"
                                TextColor="#DC3545"
                                IsVisible="False"/>

                        </VerticalStackLayout>

                        <!-- PASSWORD -->
                        <VerticalStackLayout Spacing="5">

                            <Label
                                Text="Password"
                                FontSize="15"
                                FontAttributes="Bold"
                                TextColor="#212529"/>

                            <Border
                                x:Name="passwordBorder"
                                Stroke="#D5D5D5"
                                StrokeThickness="1"
                                StrokeShape="RoundRectangle 6"
                                Padding="10,0"
                                HeightRequest="49">

                                <Grid ColumnDefinitions="*,Auto">

                                    <Entry
                                        x:Name="passwordEntry"
                                        Placeholder="Enter your password"
                                        PlaceholderColor="#667085"
                                        TextColor="#212529"
                                        BackgroundColor="Transparent"
                                        IsPassword="True"
                                        VerticalOptions="Center"
                                        TextChanged="Password_TextChanged"
                                        Focused="Password_Focused"
                                        Unfocused="Password_Unfocused"/>

                                    <!-- SHOW / HIDE PASSWORD -->
                                    <Button
                                        x:Name="passwordToggleButton"
                                        Grid.Column="1"
                                        Text="⊘"
                                        FontSize="21"
                                        TextColor="#667085"
                                        BackgroundColor="Transparent"
                                        Padding="8,0"
                                        Clicked="TogglePasswordVisibility"/>

                                </Grid>

                            </Border>

                            <Label
                                x:Name="passwordErrorLabel"
                                Text=""
                                FontSize="12"
                                TextColor="#DC3545"
                                IsVisible="False"/>

                        </VerticalStackLayout>

                        <!-- REMEMBER ME AND FORGOT PASSWORD -->
                        <Grid
                            ColumnDefinitions="*,Auto"
                            Margin="0,0,0,5">

                            <HorizontalStackLayout
                                Spacing="7"
                                VerticalOptions="Center">

                                <CheckBox
                                    x:Name="rememberMeCheckBox"
                                    Color="#0D6EFD"
                                    VerticalOptions="Center"/>

                                <Label
                                    Text="Remember me"
                                    FontSize="14"
                                    TextColor="#212529"
                                    VerticalOptions="Center"/>

                            </HorizontalStackLayout>

                            <Button
                                Grid.Column="1"
                                Text="Forgot password?"
                                FontSize="14"
                                TextColor="#0D6EFD"
                                BackgroundColor="Transparent"
                                Padding="0"
                                Clicked="ForgotPassword_Clicked"/>

                        </Grid>

                        <!-- LOGIN BUTTON -->
                        <Button
                            x:Name="loginButton"
                            Text="Login"
                            BackgroundColor="#0D6EFD"
                            TextColor="White"
                            FontSize="18"
                            HeightRequest="49"
                            CornerRadius="8"
                            Clicked="Login_Clicked"/>

                        <!-- REGISTER LINK -->
                        <HorizontalStackLayout
                            HorizontalOptions="Center"
                            Spacing="4"
                            Margin="0,5,0,0">

                            <Label
                                Text="Don't have an account?"
                                FontSize="14"
                                TextColor="#667085"
                                VerticalOptions="Center"/>

                            <Button
                                Text="Register"
                                FontSize="14"
                                FontAttributes="Bold"
                                TextColor="#0D6EFD"
                                BackgroundColor="Transparent"
                                Padding="0"
                                Clicked="Register_Clicked"/>

                        </HorizontalStackLayout>

                    </VerticalStackLayout>

                </Border>

            </Grid>

            <!-- FOOTER -->
            <Grid
                BackgroundColor="White"
                Padding="12">

                <BoxView
                    HeightRequest="1"
                    Color="#DDE2E8"
                    VerticalOptions="Start"/>

                <Label
                    Text="© 2026 Student Course Management System"
                    FontSize="14"
                    TextColor="#667085"
                    HorizontalOptions="Center"
                    Margin="0,7,0,0"/>

            </Grid>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
