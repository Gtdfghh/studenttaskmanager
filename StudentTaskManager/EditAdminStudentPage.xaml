<?xml version="1.0" encoding="utf-8" ?>

<ContentView
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="StudentTaskManager.EditAdminStudentPage">

    <Grid BackgroundColor="#F4F6FA">

        <ScrollView>
            <VerticalStackLayout Padding="35,25"
                                 Spacing="12">

                <!-- PAGE TITLE -->
                <Label Text="Edit Student"
                       FontSize="34"
                       TextColor="#1E2B3F"/>

                <Label Text="Update the student's information."
                       FontSize="15"
                       TextColor="#64748B"/>

                <!-- EDIT FORM CARD -->
                <!-- EDIT FORM CARD -->
                <Border BackgroundColor="White"
        Stroke="#E5E7EB"
        StrokeThickness="1"
        Padding="30"
        Margin="0,12,0,20"
        WidthRequest="710"
        HorizontalOptions="Start">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12"/>
                    </Border.StrokeShape>

                    <Border.Shadow>
                        <Shadow Brush="Black"
                Offset="0,4"
                Opacity="0.10"
                Radius="10"/>
                    </Border.Shadow>

                 

                <VerticalStackLayout Spacing="15">

                        <!-- NAME -->
                        <VerticalStackLayout Spacing="6">

                            <Label Text="Name"
                                   TextColor="#64748B"
                                   FontSize="14"/>

                            <Border Stroke="#D1D5DB"
                                    StrokeThickness="1"
                                    BackgroundColor="White"
                                    StrokeShape="RoundRectangle 7"
                                    Padding="10,0"
                                    HeightRequest="50">

                                <Entry x:Name="nameEntry"
                                       Placeholder="Enter student name"
                                       TextColor="#212529"
                                       PlaceholderColor="#888888"
                                       BackgroundColor="Transparent"
                                       HeightRequest="48"
                                       VerticalOptions="Center"/>

                            </Border>
                        </VerticalStackLayout>

                        <!-- DATE OF BIRTH -->
                        <VerticalStackLayout Spacing="6">

                            <Label Text="Date of Birth"
                                   TextColor="#64748B"
                                   FontSize="14"/>

                            <Border Stroke="#D1D5DB"
                                    StrokeThickness="1"
                                    BackgroundColor="White"
                                    StrokeShape="RoundRectangle 7"
                                    Padding="8,0"
                                    HeightRequest="50">

                                <DatePicker x:Name="dateOfBirthPicker"
                                            Format="dd-MM-yyyy"
                                            TextColor="#212529"
                                            BackgroundColor="Transparent"
                                            HeightRequest="48"
                                            VerticalOptions="Center"/>

                            </Border>
                        </VerticalStackLayout>

                        <!-- PHONE -->
                        <VerticalStackLayout Spacing="6">

                            <Label Text="Phone"
                                   TextColor="#64748B"
                                   FontSize="14"/>

                            <Border Stroke="#D1D5DB"
                                    StrokeThickness="1"
                                    BackgroundColor="White"
                                    StrokeShape="RoundRectangle 7"
                                    Padding="10,0"
                                    HeightRequest="50">

                                <Entry x:Name="phoneEntry"
                                       Placeholder="Enter phone number"
                                       Keyboard="Numeric"
                                       MaxLength="10"
                                       TextColor="#212529"
                                       PlaceholderColor="#888888"
                                       BackgroundColor="Transparent"
                                       HeightRequest="48"
                                       VerticalOptions="Center"/>

                            </Border>
                        </VerticalStackLayout>

                        <!-- DEPARTMENT -->
                        <VerticalStackLayout Spacing="6">

                            <Label Text="Department"
                                   TextColor="#64748B"
                                   FontSize="14"/>

                            <Border Stroke="#D1D5DB"
                                    StrokeThickness="1"
                                    BackgroundColor="White"
                                    StrokeShape="RoundRectangle 7"
                                    Padding="12"
                                    HeightRequest="50">

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Tapped="DepartmentDropdown_Tapped"/>
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="*,Auto">

                                    <Label x:Name="departmentSelectedLabel"
                                           Text="Select Department"
                                           TextColor="#888888"
                                           FontSize="14"
                                           VerticalOptions="Center"/>

                                    <Label Text="▼"
                                           Grid.Column="1"
                                           TextColor="#64748B"
                                           VerticalOptions="Center"/>

                                </Grid>
                            </Border>

                            <Border x:Name="departmentOptionsBorder"
                                    IsVisible="False"
                                    Stroke="#D1D5DB"
                                    BackgroundColor="White"
                                    StrokeThickness="1"
                                    MaximumHeightRequest="220">

                                <ScrollView>
                                    <VerticalStackLayout
                                        x:Name="departmentOptions"
                                        Spacing="0"/>
                                </ScrollView>

                            </Border>
                        </VerticalStackLayout>

                        <!-- YEAR -->
                        <VerticalStackLayout Spacing="6">

                            <Label Text="Year"
                                   TextColor="#64748B"
                                   FontSize="14"/>

                            <Border Stroke="#D1D5DB"
                                    StrokeThickness="1"
                                    BackgroundColor="White"
                                    StrokeShape="RoundRectangle 7"
                                    Padding="12"
                                    HeightRequest="50">

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Tapped="YearDropdown_Tapped"/>
                                </Border.GestureRecognizers>

                                <Grid ColumnDefinitions="*,Auto">

                                    <Label x:Name="yearSelectedLabel"
                                           Text="Select Year"
                                           TextColor="#888888"
                                           FontSize="14"
                                           VerticalOptions="Center"/>

                                    <Label Text="▼"
                                           Grid.Column="1"
                                           TextColor="#64748B"
                                           VerticalOptions="Center"/>

                                </Grid>
                            </Border>

                            <Border x:Name="yearOptionsBorder"
                                    IsVisible="False"
                                    Stroke="#D1D5DB"
                                    BackgroundColor="White"
                                    StrokeThickness="1">

                                <VerticalStackLayout
                                    x:Name="yearOptions"
                                    Spacing="0"/>

                            </Border>
                        </VerticalStackLayout>

                        <!-- BUTTONS -->
                        <HorizontalStackLayout Spacing="12"
                                               Margin="0,8,0,0">

                            <Button Text="Save Changes"
                                    BackgroundColor="#347FF0"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    Padding="18,12"
                                    CornerRadius="7"
                                    Clicked="SaveChanges_Clicked"/>

                            <Button Text="Cancel"
                                    BackgroundColor="White"
                                    TextColor="#212529"
                                    BorderColor="#D1D5DB"
                                    BorderWidth="1"
                                    Padding="20,12"
                                    CornerRadius="7"
                                    Clicked="Cancel_Clicked"/>

                        </HorizontalStackLayout>

                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentView>
