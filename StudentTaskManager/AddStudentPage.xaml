<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="StudentTaskManager.AddStudentPage"
    Title="Add Student">

    <VerticalStackLayout Padding="25" Spacing="15">

        <Label
            Text="Add New Student"
            FontSize="26"
            FontAttributes="Bold"
            HorizontalOptions="Center" />

        <Entry
            x:Name="NameEntry"
            Placeholder="Enter student name"
            TextColor="Black"
            PlaceholderColor="Gray" />

        <Entry
            x:Name="EmailEntry"
            Placeholder="Enter email"
            Keyboard="Email"
            TextColor="Black"
            PlaceholderColor="Gray" />

        <Entry
            x:Name="AgeEntry"
            Placeholder="Enter age"
            Keyboard="Numeric"
            TextColor="Black"
            PlaceholderColor="Gray" />

        <Button
            Text="Save Student"
            Clicked="OnSaveStudentClicked" />

    </VerticalStackLayout>

</ContentPage>
