<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="StudentTaskManager.StudentDetailsPage"
        xmlns:views="clr-namespace:StudentTaskManager"
    Title="Student Registration"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#F4F6FA">

    <Grid RowDefinitions="Auto,*,Auto">
        <views:AppHeader />

        <!-- REGISTRATION CONTENT -->
        <ScrollView
            Grid.Row="1"
            VerticalScrollBarVisibility="Never">

            <Grid
                Padding="20,50"
                HorizontalOptions="Fill">

                <Border
                    BackgroundColor="White"
                    StrokeThickness="0"
                    Padding="45"
                    StrokeShape="RoundRectangle 18"
                    HorizontalOptions="Center"
                    MaximumWidthRequest="760">

                    <Border.Shadow>
                        <Shadow
                            Brush="#000000"
                            Offset="0,10"
                            Radius="25"
                            Opacity="0.12"/>
                    </Border.Shadow>

                    <VerticalStackLayout Spacing="0">

                        <!-- HEADING -->
                        <Label
                            Text="Student Registration"
                            FontSize="40"
                            TextColor="#102A43"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"/>

                        <Label
                            Text="Please enter your student details to complete your registration."
                            FontSize="16"
                            TextColor="#58708D"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"
                            Margin="0,12,0,38"/>

                        <!-- GENERAL ERROR -->
                        <Label
                            x:Name="registerErrorLabel"
                            Text=""
                            FontSize="13"
                            TextColor="#DC3545"
                            IsVisible="False"
                            Margin="0,0,0,15"/>

                        <!-- FULL NAME -->
                        <Label
                            Text="Full Name"
                            FontSize="15"
                            TextColor="#183153"
                            Margin="0,0,0,10"/>

                        <Border
                            x:Name="nameBorder"
                            Stroke="#CED4DA"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 9"
                            HeightRequest="52"
                            Padding="12,0">

                            <Entry
                                x:Name="nameEntry"
                                Placeholder="Enter your full name"
                                PlaceholderColor="#667085"
                                TextColor="#212529"
                                BackgroundColor="Transparent"
                                VerticalOptions="Center"
                                TextChanged="Name_TextChanged"
                                Focused="Name_Focused"
                                Unfocused="Name_Unfocused"/>

                        </Border>

                        <Label
                            x:Name="nameErrorLabel"
                            Text=""
                            FontSize="12"
                            TextColor="#DC3545"
                            IsVisible="False"
                            Margin="0,5,0,20"/>

                        <!-- DATE OF BIRTH -->
                        <Label
                            Text="Date of Birth"
                            FontSize="15"
                            TextColor="#183153"
                            Margin="0,0,0,10"/>

                        <Border
                            x:Name="dateBorder"
                            Stroke="#CED4DA"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 9"
                            HeightRequest="52"
                            Padding="10,0">

                            <DatePicker
                                x:Name="dateOfBirthPicker"
                                Format="dd-MM-yyyy"
                                TextColor="#212529"
                                BackgroundColor="Transparent"
                                HorizontalOptions="Fill"
                                VerticalOptions="Center"
                                Focused="Date_Focused"
                                Unfocused="Date_Unfocused"
                                DateSelected="Date_Selected"/>

                        </Border>

                        <Label
                            x:Name="dateErrorLabel"
                            Text=""
                            FontSize="12"
                            TextColor="#DC3545"
                            IsVisible="False"
                            Margin="0,5,0,20"/>

                        <!-- PHONE NUMBER -->
                        <Label
                            Text="Phone Number"
                            FontSize="15"
                            TextColor="#183153"
                            Margin="0,0,0,10"/>

                        <Border
                            x:Name="phoneBorder"
                            Stroke="#CED4DA"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 9"
                            HeightRequest="52"
                            Padding="12,0">

                            <Entry
                                x:Name="phoneEntry"
                                Placeholder="Enter your phone number"
                                PlaceholderColor="#667085"
                                TextColor="#212529"
                                Keyboard="Numeric"
                                MaxLength="10"
                                BackgroundColor="Transparent"
                                VerticalOptions="Center"
                                TextChanged="Phone_TextChanged"
                                Focused="Phone_Focused"
                                Unfocused="Phone_Unfocused"/>

                        </Border>

                        <Label
                            x:Name="phoneErrorLabel"
                            Text=""
                            FontSize="12"
                            TextColor="#DC3545"
                            IsVisible="False"
                            Margin="0,5,0,20"/>

                        <!-- DEPARTMENT -->
                        <Label
                            Text="Department"
                            FontSize="15"
                            TextColor="#183153"
                            Margin="0,0,0,10"/>

                        <VerticalStackLayout
                            Spacing="0"
                            Margin="0,0,0,5">

                            <!-- DEPARTMENT SELECTOR -->
                            <Border
                                x:Name="departmentBorder"
                                Stroke="#CED4DA"
                                StrokeThickness="1"
                                BackgroundColor="White"
                                StrokeShape="RoundRectangle 9"
                                HeightRequest="52"
                                Padding="14,0">

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Tapped="DepartmentDropdown_Tapped"/>
                                </Border.GestureRecognizers>

                                <Label
                                    x:Name="departmentSelectedLabel"
                                    Text="-- Select Department --"
                                    TextColor="#555555"
                                    FontSize="15"
                                    VerticalOptions="Center"/>

                            </Border>

                            <!-- DEPARTMENT ERROR -->
                            <Label
                                x:Name="departmentErrorLabel"
                                Text=""
                                FontSize="12"
                                TextColor="#DC3545"
                                IsVisible="False"
                                Margin="0,5,0,10"/>

                            <!-- DEPARTMENT OPTIONS -->
                            <Border
                                Stroke="#CED4DA"
                                StrokeThickness="1"
                                BackgroundColor="White"
                                StrokeShape="RoundRectangle 8"
                                IsVisible="False"
                                x:Name="departmentOptionsBorder"
                                Margin="0,5,0,20">

                                <ScrollView MaximumHeightRequest="220">
                                    <VerticalStackLayout
                                        x:Name="departmentOptions"
                                        Spacing="0"/>
                                </ScrollView>

                            </Border>

                        </VerticalStackLayout>

                        <!-- YEAR -->
                        <Label
                            Text="Year"
                            FontSize="15"
                            TextColor="#183153"
                            Margin="0,15,0,10"/>

                        <VerticalStackLayout
                            Spacing="0"
                            Margin="0,0,0,25">

                            <!-- YEAR SELECTOR -->
                            <Border
                                x:Name="yearBorder"
                                Stroke="#CED4DA"
                                StrokeThickness="1"
                                BackgroundColor="White"
                                StrokeShape="RoundRectangle 9"
                                HeightRequest="52"
                                Padding="14,0">

                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Tapped="YearDropdown_Tapped"/>
                                </Border.GestureRecognizers>

                                <Label
                                    x:Name="yearSelectedLabel"
                                    Text="-- Select Year --"
                                    TextColor="#555555"
                                    FontSize="15"
                                    VerticalOptions="Center"/>

                            </Border>

                            <!-- YEAR ERROR -->
                            <Label
                                x:Name="yearErrorLabel"
                                Text=""
                                FontSize="12"
                                TextColor="#DC3545"
                                IsVisible="False"
                                Margin="0,5,0,10"/>

                            <!-- YEAR OPTIONS -->
                            <Border
                                Stroke="#CED4DA"
                                StrokeThickness="1"
                                BackgroundColor="White"
                                StrokeShape="RoundRectangle 8"
                                IsVisible="False"
                                x:Name="yearOptionsBorder"
                                Margin="0,5,0,0">

                                <VerticalStackLayout
                                    x:Name="yearOptions"
                                    Spacing="0"/>

                            </Border>

                        </VerticalStackLayout>

                        <!-- REGISTER BUTTON -->
                        <Button
                            x:Name="registerButton"
                            Text="Register"
                            BackgroundColor="#0D6EFD"
                            TextColor="White"
                            FontSize="17"
                            FontAttributes="Bold"
                            HeightRequest="54"
                            CornerRadius="9"
                            Clicked="RegisterStudent_Clicked"/>

                    </VerticalStackLayout>
                </Border>
            </Grid>
        </ScrollView>

        <!-- FOOTER -->
        <Grid
            Grid.Row="2"
            BackgroundColor="White"
            Padding="12">

            <BoxView
                HeightRequest="1"
                Color="#DDE2E8"
                VerticalOptions="Start"/>

            <Label
                Text="© 2026 Student Course Management System"
                FontSize="14"
                TextColor="#667085"
                HorizontalOptions="Center"
                Margin="0,7,0,0"/>

        </Grid>

    </Grid>
</ContentPage>
